MCP_HOST=0.0.0.0
MCP_DATA_DIR=C:/absolute/path/to/mcpserver_for_test/data
MCP_MAX_PENDING_REQUESTS=16
MCP_MAX_REQUEST_BYTES=1048576
MCP_MAX_TOOL_RESULT_BYTES=262144
# Optional comma-separated browser origins. Requests without Origin remain allowed.
# MCP_ALLOWED_ORIGINS=http://192.168.1.50:3000
# Optional shared token. Leave unset for an isolated test LAN.
# MCP_API_TOKEN=change-me
